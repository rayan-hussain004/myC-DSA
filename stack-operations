#include<stdio.h>
#define max 5
int s[max];
int t=-1;
void push(int v){
    if(t==max-1){
        printf("\nStack full\n");
        return;
    }
    t++;
    s[t]=v;
}
void pop(){
    if(t==-1){
        printf("\nStack empty\n");
        return;
    }
    printf("\nPopped= %d\n",s[t]);
    t--;
}
void peek(){
    if(t==-1){
        printf("Stack empty\n");
        return;
    }
    printf("\nTOP= %d\n",s[t]);
}
void display(){
    printf("\nStack:\n");
    for(int i=0;i<=t;i++)
        printf("%d ",s[i]);
}
int main(){
    push(1);
    push(2);
    push(3);
    display();
    pop();
    display();
    pop();
    display();
    printf("\nPushed 4\n");
    push(4);
    display();
    peek();
}
