#include<stdio.h>
#include<stdlib.h>
struct node{
    int data;
    struct node* next;
};
struct node* head=NULL;
void insertbegin(int v){
    struct node* newnode=(struct node*)malloc(sizeof(struct node));
    newnode->data=v;
    newnode->next=head;
    head=newnode;
}
void display(){
    struct node* temp=head;
    while(temp!=NULL){
        printf("%d->",*temp);
        temp=temp->next;
    }
    printf("NULL\n");
}
void main(){
    insertbegin(10);
    insertbegin(20);
    insertbegin(30);
    display();
}
