#include <stdio.h>
#include <stdlib.h>

char *my_strdup(char *src) {
    char *dup, *p, *q;
    int len = 0;

    // Find the length of src using pointer arithmetic
    for (p = src; *p != '\0'; p++)
        len++;

    // Allocate memory for duplicate string (+1 for null terminator)
    dup = (char *)malloc((len + 1) * sizeof(char));
    if (dup == NULL)
        return NULL; // Allocation failed

    // Copy characters using pointer arithmetic
    q = dup;
    for (p = src; *p != '\0'; p++, q++)
        *q = *p;

    *q = '\0'; // Null terminate the new string

    return dup;
}

int main() {
    char str[100];
    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    // Remove newline if present
    for (char *p = str; *p != '\0'; p++) {
        if (*p == '\n') {
            *p = '\0';
            break;
        }
    }

    char *copy = my_strdup(str);

    if (copy == NULL) {
        printf("Memory allocation failed!\n");
        return 1;
    }

    printf("Original: %s\n", str);
    printf("Duplicate: %s\n", copy);

    free(copy); // Free the duplicated string
    return 0;
}


