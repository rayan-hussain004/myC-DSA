#include<stdio.h>
#include<stdlib.h>

char *getLine(void) {
    char *buffer = NULL;   
    int size = 0;          
    int capacity = 10;     
    int ch;
    buffer = (char *)malloc(capacity * sizeof(char));
    if (buffer == NULL) {
        printf("Memory allocation failed!\n");
        return NULL;
    }
    while ((ch = getchar()) != '\n' && ch != EOF) {
        buffer[size++] = (char)ch;
        if (size >= capacity) {
            capacity *= 2;
            char *new_buffer = (char *)realloc(buffer, capacity * sizeof(char));
            if (new_buffer == NULL) {
                printf("Reallocation failed!\n");
                free(buffer);
                return NULL;
            }
            buffer = new_buffer;
        }
    }
    buffer[size] = '\0';
    char *final = (char *)realloc(buffer, (size + 1) * sizeof(char));
    return (final != NULL) ? final : buffer;
}
int main() {
    printf("Enter a line of text:\n");
    char *line = getLine();
    if (line == NULL) {
        printf("Failed to read line.\n");
        return 1;
    }
    printf("\nYou entered: \"%s\"\n", line);
    free(line);
    return 0;
}


