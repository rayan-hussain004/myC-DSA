int main(){
    int **marks = NULL;   
    int *numSubjects = NULL;
    int numStudents;
    int i, j;

    printf("Enter number of students: ");
    scanf("%d", &numStudents);
    marks = (int **)malloc(numStudents * sizeof(int *));
    numSubjects = (int *)malloc(numStudents * sizeof(int));
    if (marks == NULL || numSubjects == NULL) {
        printf("Memory allocation failed!\n");
        return 1;
    }
    for (i = 0; i < numStudents; i++) {
        printf("\nEnter number of subjects for student %d: ", i + 1);
        scanf("%d", &numSubjects[i]);
        marks[i] = (int *)malloc(numSubjects[i] * sizeof(int));
        if (marks[i] == NULL) {
            printf("Memory allocation failed!\n");
            for (int k = 0; k < i; k++)
                free(marks[k]);
            free(marks);
            free(numSubjects);
            return 1;
        }
        printf("Enter %d marks for student %d: ", numSubjects[i], i + 1);
        for (j = 0; j < numSubjects[i]; j++)
            scanf("%d", &marks[i][j]);
    }
    float *avg = (float *)malloc(numStudents * sizeof(float));
    if (avg == NULL) {
        printf("Memory allocation failed!\n");
        for (i = 0; i < numStudents; i++)
            free(marks[i]);
        free(marks);
        free(numSubjects);
        return 1;
    }
    int topper = 0;
    for (i = 0; i < numStudents; i++) {
        int sum = 0;
        for (j = 0; j < numSubjects[i]; j++)
            sum += marks[i][j];
        avg[i] = (float)sum / numSubjects[i];
        if (avg[i] > avg[topper])
            topper = i;
    }
    printf("\n--- Student Averages ---\n");
    for (i = 0; i < numStudents; i++)
        printf("Student %d average: %.2f\n", i + 1, avg[i]);
    printf("\nTopper: Student %d with average %.2f\n", topper + 1, avg[topper]);
    for (i = 0; i < numStudents; i++)
        free(marks[i]);
    free(marks);
    free(numSubjects);
    free(avg);
    return 0;
}


