#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int *data;       // Pointer to array elements
    int size;        // Current number of elements
    int capacity;    // Allocated capacity
} DynamicArray;

// Initialize dynamic array with initial capacity
void init(DynamicArray *arr, int initial_capacity) {
    arr->size = 0;
    arr->capacity = initial_capacity;
    arr->data = (int *)malloc(arr->capacity * sizeof(int));
    if (arr->data == NULL) {
        printf("Memory allocation failed!\n");
        exit(1);
    }
}

// Push element to dynamic array, doubling capacity when full
void push(DynamicArray *arr, int value) {
    if (arr->size == arr->capacity) {
        arr->capacity *= 2; // Double capacity
        int *new_data = (int *)realloc(arr->data, arr->capacity * sizeof(int));
        if (new_data == NULL) {
            printf("Reallocation failed!\n");
            free(arr->data);
            exit(1);
        }
        arr->data = new_data;
        printf("Capacity doubled to %d\n", arr->capacity);
    }

    arr->data[arr->size++] = value;
}

// Print array contents
void printArray(DynamicArray *arr) {
    printf("Array elements (%d/%d): ", arr->size, arr->capacity);
    for (int i = 0; i < arr->size; i++) {
        printf("%d ", arr->data[i]);
    }
    printf("\n");
}

// Free memory
void freeArray(DynamicArray *arr) {
    free(arr->data);
    arr->data = NULL;
    arr->size = arr->capacity = 0;
}

// Example usage
int main() {
    DynamicArray arr;
    init(&arr, 2); // Start with small capacity

    int n, val;
    printf("Enter number of elements to push: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        printf("Enter value %d: ", i + 1);
        scanf("%d", &val);
        push(&arr, val);
        printArray(&arr);
    }

    freeArray(&arr);
    return 0;
}


