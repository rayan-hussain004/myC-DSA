#include <stdio.h>
#include <stdlib.h>

int main() {
    int n1, n2;
    int *a = NULL, *b = NULL, *merged = NULL;
    int i = 0, j = 0, k = 0;

    // Input sizes
    printf("Enter size of first sorted array: ");
    scanf("%d", &n1);
    printf("Enter size of second sorted array: ");
    scanf("%d", &n2);

    // Allocate memory
    a = (int *)malloc(n1 * sizeof(int));
    b = (int *)malloc(n2 * sizeof(int));

    if (a == NULL || b == NULL) {
        printf("Memory allocation failed!\n");
        return 1;
    }

    // Input sorted arrays
    printf("Enter %d sorted elements for first array:\n", n1);
    for (i = 0; i < n1; i++)
        scanf("%d", a + i);

    printf("Enter %d sorted elements for second array:\n", n2);
    for (i = 0; i < n2; i++)
        scanf("%d", b + i);

    // Allocate enough memory for merged array (max possible = n1 + n2)
    merged = (int *)malloc((n1 + n2) * sizeof(int));
    if (merged == NULL) {
        printf("Memory allocation failed!\n");
        free(a);
        free(b);
        return 1;
    }

    // Merge without duplicates
    i = j = k = 0;
    while (i < n1 && j < n2) {
        if (*(a + i) < *(b + j))
            merged[k++] = a[i++];
        else if (*(a + i) > *(b + j))
            merged[k++] = b[j++];
        else {
            merged[k++] = a[i];
            i++;
            j++;
        }
        // Remove duplicates while merging
        while (i < n1 && merged[k - 1] == *(a + i)) i++;
        while (j < n2 && merged[k - 1] == *(b + j)) j++;
    }

    // Copy remaining elements
    while (i < n1) {
        if (k == 0 || merged[k - 1] != *(a + i))
            merged[k++] = *(a + i);
        i++;
    }
    while (j < n2) {
        if (k == 0 || merged[k - 1] != *(b + j))
            merged[k++] = *(b + j);
        j++;
    }

    // Shrink memory to actual number of elements
    int *temp = (int *)realloc(merged, k * sizeof(int));
    if (temp != NULL)
        merged = temp;

    // Print result
    printf("\nMerged sorted array without duplicates:\n");
    for (i = 0; i < k; i++)
        printf("%d ", *(merged + i));
    printf("\n");

    // Free all memory
    free(a);
    free(b);
    free(merged);

    return 0;
}


