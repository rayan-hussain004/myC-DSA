#include <stdlib.h>

int main() {
    int R, C;
    int *mat = NULL;        // original matrix
    int *trans = NULL;      // transposed matrix (if needed)
    int i, j;

    printf("Enter number of rows (R): ");
    scanf("%d", &R);
    printf("Enter number of columns (C): ");
    scanf("%d", &C);

    // Allocate R*C elements in a single malloc
    mat = (int *)malloc(R * C * sizeof(int));
    if (mat == NULL) {
        printf("Memory allocation failed!\n");
        return 1;
    }

    // Input matrix elements using pointer arithmetic
    printf("Enter %d elements:\n", R * C);
    for (i = 0; i < R; i++) {
        for (j = 0; j < C; j++) {
            scanf("%d", (mat + i * C + j));
        }
    }

    printf("\nOriginal Matrix:\n");
    for (i = 0; i < R; i++) {
        for (j = 0; j < C; j++) {
            printf("%d ", *(mat + i * C + j));
        }
        printf("\n");
    }

    // If square, transpose in place
    if (R == C) {
        printf("\nTranspose (in-place):\n");
        for (i = 0; i < R; i++) {
            for (j = 0; j < C; j++) {
                printf("%d ", *(mat + j * C + i));
            }
            printf("\n");
        }
    } else {
        // Allocate new memory for transpose (C x R)
        trans = (int *)malloc(C * R * sizeof(int));
        if (trans == NULL) {
            printf("Memory allocation for transpose failed!\n");
            free(mat);
            return 1;
        }

        // Fill transposed matrix
        for (i = 0; i < R; i++) {
            for (j = 0; j < C; j++) {
                *(trans + j * R + i) = *(mat + i * C + j);
            }
        }

        printf("\nTranspose (stored in new matrix):\n");
        for (i = 0; i < C; i++) {
            for (j = 0; j < R; j++) {
                printf("%d ", *(trans + i * R + j));
            }
            printf("\n");
        }

        free(trans);
    }

    free(mat);
    return 0;
}


