#include<stdio.h>
#include<stdlib.h>

typedef struct {
    int width;
    int height;
    unsigned char *data;
} Image;
Image *createImage(int width, int height) {
    Image *img = (Image *)malloc(sizeof(Image));
    if (img == NULL) {
        printf("Memory allocation failed!\n");
        exit(1);
    }
    img->width = width;
    img->height = height;
    img->data = (unsigned char *)malloc(width * height * sizeof(unsigned char));
    if (img->data == NULL) {
        printf("Image data allocation failed!\n");
        free(img);
        exit(1);
    }
    for (int i = 0; i < width * height; i++)
        img->data[i] = 0;
    return img;
}
unsigned char getPixel(Image *img, int x, int y) {
    if (x < 0 || x >= img->width || y < 0 || y >= img->height) {
        printf("getPixel: Invalid coordinates (%d, %d)\n", x, y);
        return 0;
    }
    return img->data[y * img->width + x];
}
void setPixel(Image *img, int x, int y, unsigned char value) {
    if (x < 0 || x >= img->width || y < 0 || y >= img->height) {
        printf("setPixel: Invalid coordinates (%d, %d)\n", x, y);
        return;
    }
    img->data[y * img->width + x] = value;
}
void printImage(Image *img) {
    printf("\nImage (%d x %d):\n", img->width, img->height);
    for (int y = 0; y < img->height; y++) {
        for (int x = 0; x < img->width; x++) {
            printf("%3d ", getPixel(img, x, y));
        }
        printf("\n");
    }
}
void freeImage(Image *img) {
    if (img) {
        free(img->data);
        free(img);
    }
}

int main() {
    int W, H;
    printf("Enter image width and height: ");
    scanf("%d %d", &W, &H);
    Image *img = createImage(W, H);
    for (int i = 0; i < W && i < H; i++)
        setPixel(img, i, i, (i * 255) / (W > H ? W : H));
    printImage(img);
    freeImage(img);
    return 0;
}

