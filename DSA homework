#include <stdio.h>
#include <stdlib.h>

char *getLine(void) {
    char *buffer = NULL;   // Dynamic buffer
    int size = 0;          // Number of characters read
    int capacity = 10;     // Initial capacity
    int ch;

    buffer = (char *)malloc(capacity * sizeof(char));
    if (buffer == NULL) {
        printf("Memory allocation failed!\n");
        return NULL;
    }

    // Read characters until newline or EOF
    while ((ch = getchar()) != '\n' && ch != EOF) {
        buffer[size++] = (char)ch;

        // If buffer full, double capacity
        if (size >= capacity) {
            capacity *= 2;
            char *new_buffer = (char *)realloc(buffer, capacity * sizeof(char));
            if (new_buffer == NULL) {
                printf("Reallocation failed!\n");
                free(buffer);
                return NULL;
            }
            buffer = new_buffer;
        }
    }

    // Add null terminator
    buffer[size] = '\0';

    // Optionally shrink to exact size
    char *final = (char *)realloc(buffer, (size + 1) * sizeof(char));
    return (final != NULL) ? final : buffer;
}

int main() {
    printf("Enter a line of text:\n");
    char *line = getLine();

    if (line == NULL) {
        printf("Failed to read line.\n");
        return 1;
    }

    printf("\nYou entered: \"%s\"\n", line);

    free(line);
    return 0;
}


