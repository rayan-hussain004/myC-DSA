int main() {
    int R, C;
    int *mat = NULL;        
    int *trans = NULL;      
    int i, j;
    printf("Enter number of rows (R): ");
    scanf("%d", &R);
    printf("Enter number of columns (C): ");
    scanf("%d", &C);
    mat = (int *)malloc(R * C * sizeof(int));
    if (mat == NULL) {
        printf("Memory allocation failed!\n");
        return 1;
    }
    printf("Enter %d elements:\n", R * C);
    for (i = 0; i < R; i++) {
        for (j = 0; j < C; j++) {
            scanf("%d", (mat + i * C + j));
        }
    }
    printf("\nOriginal Matrix:\n");
    for (i = 0; i < R; i++) {
        for (j = 0; j < C; j++) {
            printf("%d ", *(mat + i * C + j));
        }
        printf("\n");
    }
    if (R == C) {
        printf("\nTranspose (in-place):\n");
        for (i = 0; i < R; i++) {
            for (j = 0; j < C; j++) {
                printf("%d ", *(mat + j * C + i));
            }
            printf("\n");
        }
    } else {
        trans = (int *)malloc(C * R * sizeof(int));
        if (trans == NULL) {
            printf("Memory allocation for transpose failed!\n");
            free(mat);
            return 1;
        }
        for (i = 0; i < R; i++) {
            for (j = 0; j < C; j++) {
                *(trans + j * R + i) = *(mat + i * C + j);
            }
        }
        printf("\nTranspose (stored in new matrix):\n");
        for (i = 0; i < C; i++) {
            for (j = 0; j < R; j++) {
                printf("%d ", *(trans + i * R + j));
            }
            printf("\n");
        }
        free(trans);
    }
    free(mat);
    return 0;
}


