#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Function to split a string dynamically
char **split(char *str, char delim, int *count) {
    char **tokens = NULL;   // Array of strings
    char *token_start = str;
    int token_count = 0;

    while (*str) {
        if (*str == delim) {
            // Found a delimiter → extract substring
            int length = str - token_start;
            char *token = (char *)malloc((length + 1) * sizeof(char));
            if (token == NULL) {
                printf("Memory allocation failed!\n");
                exit(1);
            }

            strncpy(token, token_start, length);
            token[length] = '\0';

            // Reallocate token array to hold one more string
            char **new_tokens = (char **)realloc(tokens, (token_count + 1) * sizeof(char *));
            if (new_tokens == NULL) {
                printf("Reallocation failed!\n");
                exit(1);
            }
            tokens = new_tokens;
            tokens[token_count++] = token;

            token_start = str + 1;  // Move past delimiter
        }
        str++;
    }

    // Handle last token (after last delimiter)
    if (str != token_start) {
        int length = str - token_start;
        char *token = (char *)malloc((length + 1) * sizeof(char));
        if (token == NULL) {
            printf("Memory allocation failed!\n");
            exit(1);
        }

        strncpy(token, token_start, length);
        token[length] = '\0';

        char **new_tokens = (char **)realloc(tokens, (token_count + 1) * sizeof(char *));
        if (new_tokens == NULL) {
            printf("Reallocation failed!\n");
            exit(1);
        }
        tokens = new_tokens;
        tokens[token_count++] = token;
    }

    *count = token_count;
    return tokens;
}

int main() {
    char input[200];
    char delim;
    int count, i;

    printf("Enter a string: ");
    fgets(input, sizeof(input), stdin);

    // Remove newline if present
    input[strcspn(input, "\n")] = '\0';

    printf("Enter a delimiter character: ");
    scanf("%c", &delim);

    char **result = split(input, delim, &count);

    printf("\nTokens (%d):\n", count);
    for (i = 0; i < count; i++) {
        printf("[%d] \"%s\"\n", i + 1, result[i]);
        free(result[i]);  // Free each token
    }

    free(result); // Free the array of pointers
    return 0;
}

