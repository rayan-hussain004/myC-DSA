#include<stdio.h>
#include<stdlib.h>
int main(){
    int n,sum=0;
    printf("Enter size of array: ");
    scanf("%d",&n);
    int *arr=(int*)malloc(n*sizeof(int));
    if(arr==NULL){
        printf("Error in allocation\n");
        return 0;
    }
    printf("Enter %d elemants:\n",n);
    for(int i=0;i<n;i++){
        scanf("%d",arr);
        sum+=*arr;
    }
    printf("Sum= %d\n",sum);
    free(arr);
    return 0;
}
