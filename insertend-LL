#include<stdio.h>
#include<stdlib.h>

struct node{
    int data;
    struct node* next;
};
struct node* head=NULL;
void insertend(int v){
    struct node* newnode=(struct node*)malloc(sizeof(struct node));
    newnode->data=v;
    newnode->next=NULL;
    if(head==NULL)
        head=newnode;
    else{
        struct node* temp=head;
        while(temp->next!=NULL)
            temp=temp->next;
        temp->next=newnode;
    }
}
void display(){
    struct node* temp=head;
    printf("Head= %p\n",head);
    while(temp!=NULL){
        printf("%d (%p)->",*temp,temp->next);
        temp=temp->next;
    }
    printf("NULL\n");
}
void main(){
    insertend(10);
    insertend(20);
    display();
}
