#include<stdio.h>
#include<stdlib.h>
struct node{
    int data;
    struct node* next;
};
struct node* head=NULL;
void insertend(int v){
    struct node* newnode=(struct node*)malloc(sizeof(struct node));
    newnode->data=v;
    newnode->next=NULL;
    if(head==NULL)
        head=newnode;
    else{
        struct node* temp=head;
        while(temp->next!=NULL)
            temp=temp->next;
        temp->next=newnode;
    }
}
void delbegin(){
    struct node* temp=head;
    if(head->next==NULL){
        head==NULL;
        free(temp);
    }
    else{
        head=head->next;
        free(temp);
    }
}
void delend(){
    struct node* temp=head;
    if(head->next==NULL){
        head==NULL;
        free(temp);
}
    else{
        while(temp->next->next!=NULL)
            temp=temp->next;
        temp->next=NULL;
        free(temp);
    }
}
void delpos(int p){
    struct node* temp=head;
    if(p==1){
      head=temp->next;
      free(temp);
      return;
    }
    struct node* temp1;
    for(int i=1;i<p-1&&temp!=NULL;i++)
      temp=temp->next;
    temp1=temp->next->next;
    temp->next=temp1;
    free(temp);free(temp1);
}
void display(){
    struct node* temp=head;
    if(temp==NULL)
        printf("Empty list\n");
    while(temp!=NULL){
        printf("%d->",temp->data);
        temp=temp->next;
    }
    printf("NULL\n");
}
