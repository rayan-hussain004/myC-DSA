        printf("\nSelect choice:\n1.Enqueue\n2.Dequeue\n3.Peek\n4.Display\n");
        scanf("%d",&x);
        switch(x){
            case 1:int a;
                    printf("Enter value: ");
                    scanf("%d",&a);
                    enq(a);break;
